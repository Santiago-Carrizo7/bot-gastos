# Entorno
NODE_ENV=development
PORT=3000
API_SECRET=cambiar_este_secreto_por_uno_seguro_en_produccion

# Telegram Bot
# Obtené tu token con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bot_gastos?schema=public"

# Proveedor de IA (Texto)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Proveedor de Speech-to-Text (Audio / Voz)
# Opciones: groq (recomendado por rapidez y costo cero) | openai | disabled
STT_PROVIDER=groq
STT_API_KEY=tu_groq_api_key_aqui
STT_MODEL=whisper-large-v3-turbo
# STT_BASE_URL=https://api.groq.com/openai/v1
