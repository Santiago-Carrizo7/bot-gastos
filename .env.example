# Entorno
NODE_ENV=development

# Telegram Bot
# Obtené tu token con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui

# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/bot_gastos?schema=public"

# Proveedor de IA
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
# Modelo a utilizar (por defecto rápido y económico)
OPENROUTER_MODEL=google/gemini-2.0-flash-001
